<!--
  Pick days (or any pools) and how many, then hold them. `days` is what `reserve.days()` returns,
  each with a `label` the app adds ("Fri 20 Nov"). A day with none free can't be picked; a day
  the holder already holds is ticked. A plain form post to `hold` (the app's route) with `key`,
  every ticked `pool`, and `count`, so it works without JavaScript.
-->
<script>
  import './action-button.zb'
</script>
<style>
  :host { display: block; }
  form { display: grid; gap: 1rem; padding: 1.1rem 1.2rem; border-radius: var(--radius, 0.5rem); background: var(--card, #fff); box-shadow: 0 0 0 1px var(--border, #dde); }
  fieldset { display: grid; gap: 0.5rem; margin: 0; padding: 0; border: 0; }
  legend { padding: 0; margin-bottom: 0.4rem; font-family: var(--font-heading, inherit); font-size: 1.2rem; font-weight: 700; }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  label.day { display: grid; gap: 0.15rem; padding: 0.6rem 0.75rem; border-radius: var(--radius, 0.5rem); box-shadow: 0 0 0 1px var(--border, #dde); cursor: pointer; }
  label.day:has(input:checked) { box-shadow: 0 0 0 2px var(--primary, #234); }
  label.day:has(input:disabled) { opacity: 0.55; cursor: not-allowed; }
  label.day span { font-size: 0.875rem; color: var(--muted-foreground, #667); }
  .count { display: flex; align-items: center; gap: 0.6rem; }
  .count input { width: 5rem; padding: 0.4rem 0.5rem; font: inherit; }
</style>
<slot-picker days={[]} hold="" key="" count={1} max={4} heading="Pick your days" unit="kayak">
  <form method="post" action={hold}>
    <input type="hidden" name="key" value={key}>
    <fieldset>
      <legend>{heading}</legend>
      <ul>
        <zb-each items={days} as="day" key={day.pool}>
          <li>
            <label class="day" data-pool={day.pool}>
              <span><input type="checkbox" name="pool" value={day.pool} checked={day.mine} disabled={day.free === 0 && !day.mine}> {day.label ?? day.pool}</span>
              <span>{day.free === 0 ? 'None free' : `${day.free} free`}</span>
            </label>
          </li>
        </zb-each>
      </ul>
    </fieldset>
    <p class="count">
      <label for="slot-picker-count">How many</label>
      <input
        id="slot-picker-count"
        type="number"
        name="count"
        min="1"
        max={String(max)}
        value={String(count)}
        required
      >
      <span>{unit}{count === 1 ? '' : 's'}</span>
    </p>
    <action-button type="submit">Hold</action-button>
  </form>
</slot-picker>
