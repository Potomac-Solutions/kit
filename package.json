{
  "name": "@potomac-solutions/kit",
  "version": "0.7.0",
  "private": true,
  "description": "Shared server modules and components for Potomac Solutions platforms, built on Zubra",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./store": "./modules/store/index.js",
    "./hold": "./modules/hold/index.js",
    "./stages": "./modules/stages/index.js",
    "./tenant": "./modules/tenant/index.js",
    "./price": "./modules/price/index.js",
    "./pay": "./modules/pay/index.js",
    "./auth": "./modules/auth/index.js",
    "./staff": "./modules/staff/index.js",
    "./staff/pages": "./modules/staff/pages.js",
    "./notify": "./modules/notify/index.js",
    "./files": "./modules/files/index.js",
    "./catalog": "./modules/catalog/index.js",
    "./cart": "./modules/cart/index.js",
    "./checkout": "./modules/checkout/index.js",
    "./reserve": "./modules/reserve/index.js",
    "./tenancy": "./modules/tenancy/index.js",
    "./components/*": "./components/*"
  },
  "files": [
    "modules/*/index.js",
    "modules/staff/pages.js",
    "components/*.zb",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"modules/**/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"components/test/*.test.js\"",
    "mutate": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@zubra/compiler": "^5.10.2",
    "@zubra/runtime": "^5.10.2",
    "@zubra/server": "^5.10.2",
    "@zubra/sync": "^5.10.2",
    "playwright": "^1.65.0"
  },
  "peerDependencies": {
    "@zubra/server": ">=5.9.0"
  },
  "peerDependenciesMeta": {
    "@zubra/server": {
      "optional": true
    }
  }
}
